{
  "name": "blt-legal",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  // 有報LAB（iOS アプリ）の免責・プライバシー・利用規約静的ページ。api.* / mcp.* の前段に置かない。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // yuholab.com が配信先。sollahiro.com は別 Worker（sollahiro-home、リポジトリ外）が持つので載せない。
  "routes": [
    {
      "pattern": "yuholab.com",
      "custom_domain": true
    }
  ]
}
