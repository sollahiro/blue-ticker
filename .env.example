# 手元ジョブは `set -a; . ./.env; set +a` で読む（.env は gitignore。本ファイルをコピーして作る）。
# URL と R2 秘密鍵はシングルクォート、それ以外は裸。
# Neon の役割・禁止事項の正本は AGENTS.md「Neon Secrets」。

# =============================================================================
# Neon / Postgres
# =============================================================================
# アプリ（blt-server）が読む接続先は常に DATABASE_URL のみ。
#
# ブランチ対応（Neon）:
#   WRITE 親 = BLT_PROD_WRITE_DATABASE_URL  / NEON_WRITE_BRANCH_ID（br-…）
#   RO 子   = BLT_PROD_DATABASE_URL        / NEON_RO_BRANCH_ID（br-…）
# RO は WRITE の自動レプリカではない（作成／reset 時点のコピー）。
# 本番 ingest 後に揃える: scripts/neon-reset-ro-from-parent.sh（NEON_* 4つが必要）
#
# 本番 write は .env の DATABASE_URL を差し替えず、コマンド単位で上書きする:
#   DATABASE_URL="$BLT_PROD_WRITE_DATABASE_URL" ./.build/release/blt-server ingest ...

# 使い捨て（探索・検証・スキーマやり直し）。本番を指させない。未設定＝ステートレス起動。
DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'

# 本番 SELECT / 件数確認のみ（WRITE の子ブランチ）。
# 禁止: 書き込み・DROP・これを DATABASE_URL にして起動（autoMigrate が走る）。
BLT_PROD_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'

# 本番 ingest 用（WRITE 親＝大元ブランチ）。既定の DATABASE_URL 差し替え禁止。
# 使うときだけ上のコマンド単位上書き。未検証の探索 ingest に使わない。
BLT_PROD_WRITE_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'

# RO を親へ reset（scripts/neon-reset-ro-from-parent.sh）。
# branch id は br-… のみ（接続 URL の ep-… や postgresql:// を流用しない）。
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
NEON_WRITE_BRANCH_ID=br-xxxxxxxx
NEON_RO_BRANCH_ID=br-xxxxxxxx

# =============================================================================
# EDINET
# =============================================================================
# ローカル起動はダミー可（例: BLT_EDINET_API_KEY=dev-local-dummy）。実取得・smoke は実キー。
BLT_EDINET_API_KEY=your_api_key_here

# =============================================================================
# 内訳 LLM（breakdowns business / geography）
# =============================================================================
# openai | xai（未設定は xai）。キーは両方置いたまま LLM_PROVIDER で切替できる。
LLM_PROVIDER=openai
OPENAI_BUSINESS_API_KEY=your_api_key_here
OPENAI_BUSINESS_MODEL=gpt-5.6-luna
OPENAI_GEOGRAPHY_API_KEY=your_api_key_here
OPENAI_GEOGRAPHY_MODEL=gpt-5.6-luna
XAI_BUSINESS_API_KEY=your_api_key_here
XAI_BUSINESS_MODEL=your_xai_model_here
XAI_GEOGRAPHY_API_KEY=your_api_key_here
XAI_GEOGRAPHY_MODEL=your_xai_model_here

# =============================================================================
# R2（会社アイコン）
# =============================================================================
# read 経路は BLT_R2_PUBLIC_BASE_URL のみ。アップロードには ACCOUNT_ID / 鍵 / BUCKET も必要。
BLT_R2_PUBLIC_BASE_URL='https://your_r2_public_base_url_here'
BLT_R2_ACCOUNT_ID=your_account_id_here
BLT_R2_ACCESS_KEY_ID='your_access_key_id_here'
BLT_R2_SECRET_ACCESS_KEY='your_secret_access_key_here'
BLT_R2_BUCKET='your_bucket_here'
