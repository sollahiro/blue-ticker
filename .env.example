# 手元ジョブは `set -a; . ./.env; set +a` で読む（.env は gitignore。本ファイルをコピーして作る）。
# 接続 URL・R2 秘密鍵はシングルクォート。DATABASE_URL の役割参照だけダブルクォート（展開用）。
# Neon 接続変数の正本は本ファイル。本番 write の常時禁止事項は AGENTS.md、実行手順は production-ingest skill。

# =============================================================================
# Neon / Postgres
# =============================================================================
# DATABASE_URL は「プロセスが接続するスロット」だけ（blt-ingest / blt-server が読む唯一の接続先）。
# 役割つき URL は下の BLT_NEON_*。手元の既定は READ（読み取り専用）を DATABASE_URL に束ねる。
#
# 役割（どちらも Neon の本番ブランチ。子ブランチは使わない。docs/process/neon-branches.md）:
#   READ  = BLT_NEON_READ_DATABASE_URL（blt_reader。SELECT のみ・read_only。Fly の DATABASE_URL と同じ）
#   WRITE = BLT_NEON_WRITE_DATABASE_URL（本番 ingest・migrate。Mac の blt-ingest だけが使う）
#
# 探索・検証・スキーマのやり直しは手元のローカル Postgres で行う（.agents/skills/local-rest-testing）。
# 本番ブランチを使い捨ての検証先にしない。
#
# 本番 write は .env の DATABASE_URL を差し替えず、コマンド単位で上書きする:
#   DATABASE_URL="$BLT_NEON_WRITE_DATABASE_URL" ./.build/release/blt-ingest ingest ...
#
# 旧名（廃止）: BLT_PROD_WRITE_DATABASE_URL → BLT_NEON_WRITE_DATABASE_URL
# 廃止: BLT_NEON_DISPOSABLE_DATABASE_URL（使い捨て Neon ブランチは削除済み。ローカル Postgres を使う）

# 本番の読み取り専用（blt_reader）。件数確認や手元 serve はこれで足りる。
BLT_NEON_READ_DATABASE_URL='postgresql://blt_reader:PASSWORD@HOST/DB?sslmode=require'

# 本番 ingest 用（WRITE＝大元ブランチ）。既定の DATABASE_URL 差し替え禁止。
# 使うときだけコマンド単位上書き。未検証の探索 ingest に使わない。
BLT_NEON_WRITE_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'

# プロセス束縛（アプリが読むのはこれのみ）。未設定＝ステートレス起動。
# 手元の既定は READ。Fly 等のデプロイ先ではその環境の接続先を直接入れる。
DATABASE_URL="$BLT_NEON_READ_DATABASE_URL"

# =============================================================================
# EDINET
# =============================================================================
# ローカル起動はダミー可（例: BLT_EDINET_API_KEY=dev-local-dummy）。実取得・smoke は実キー。
BLT_EDINET_API_KEY=your_api_key_here


# =============================================================================
# Overview LLM（銘柄の短い会社説明。ingest 時のみ。公開 REST 未配線）
# =============================================================================
# 機能別キー。新 VM に発行・再登録する名前。
OPENROUTER_OVERVIEW_API_KEY=your_api_key_here
OPENROUTER_OVERVIEW_MODEL=google/gemini-2.5-flash
# OPENROUTER_OVERVIEW_BASE_URL=https://openrouter.ai/api/v1

# セグメント注記・関係会社表の区分（ingest stage `relations`）の Jev（Decisions API）。
# 未設定なら今日の分類のまま（関係会社表は区分の決まらない行を needs_review で残し、公開しない）。Overview のキーとは別。
OPENROUTER_DECISION_API_KEY=your_api_key_here

# =============================================================================
# R2（会社アイコン公開 URL ＋ 生 XBRL ZIP の私有 L2）
# =============================================================================
# 会社アイコンの配信は BLT_R2_PUBLIC_BASE_URL のみ（repo は ingest しない。オブジェクトは手置き）。
# 生 XBRL の L2（`jp/edinet/xbrl/{docID}.zip`）は ACCOUNT_ID / 鍵 / XBRL_BUCKET が揃えば有効。
# 公開 URL は不要。未設定時はローカル → EDINET の従来経路。
BLT_R2_ACCOUNT_ID=your_account_id_here
BLT_R2_ACCESS_KEY_ID='your_access_key_id_here'
BLT_R2_SECRET_ACCESS_KEY='your_secret_access_key_here'
BLT_R2_PUBLIC_BASE_URL='https://your_r2_public_base_url_here'
BLT_R2_XBRL_BUCKET='your_xbrl_bucket_here'
