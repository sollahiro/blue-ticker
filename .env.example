# 手元ジョブは `set -a; . ./.env; set +a` で読む（.env は gitignore。本ファイルをコピーして作る）。
# 接続 URL・R2 秘密鍵はシングルクォート。DATABASE_URL の役割参照だけダブルクォート（展開用）。
# Neon の役割・禁止事項の正本は AGENTS.md「Neon Secrets」。

# =============================================================================
# Neon / Postgres
# =============================================================================
# DATABASE_URL は「プロセスが接続するスロット」だけ（blt-server が読む唯一の接続先）。
# 役割つき URL は下の BLT_NEON_*。手元の既定は disposable を DATABASE_URL に束ねる。
#
# 役割（接続 URL ↔ Neon branch id）:
#   disposable = BLT_NEON_DISPOSABLE_DATABASE_URL（探索・検証・スキーマやり直し。本番を指させない）
#   WRITE 親   = BLT_NEON_WRITE_DATABASE_URL  / NEON_WRITE_BRANCH_ID（br-…）
#   RO 子      = BLT_NEON_RO_DATABASE_URL     / NEON_RO_BRANCH_ID（br-…）
# RO は WRITE の自動レプリカではない（作成／reset 時点のコピー）。
# 本番 ingest 後に揃える: scripts/neon-reset-ro-from-parent.sh（NEON_* 4つが必要）
#
# 本番 write は .env の DATABASE_URL を差し替えず、コマンド単位で上書きする:
#   DATABASE_URL="$BLT_NEON_WRITE_DATABASE_URL" ./.build/release/blt-server ingest ...
#
# 旧名（廃止）: BLT_PROD_DATABASE_URL → BLT_NEON_RO_DATABASE_URL
#                BLT_PROD_WRITE_DATABASE_URL → BLT_NEON_WRITE_DATABASE_URL
# 以前「DATABASE_URL＝使い捨て」と書いていた意味は BLT_NEON_DISPOSABLE_DATABASE_URL へ分離。

# 使い捨て（探索・検証・スキーマやり直し）。本番を指させない。
BLT_NEON_DISPOSABLE_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'

# 本番 SELECT / 件数確認のみ（WRITE の子ブランチ = RO）。
# 禁止: 書き込み・DROP・これを DATABASE_URL にして起動（autoMigrate が走る）。
BLT_NEON_RO_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'

# 本番 ingest 用（WRITE 親＝大元ブランチ）。既定の DATABASE_URL 差し替え禁止。
# 使うときだけコマンド単位上書き。未検証の探索 ingest に使わない。
BLT_NEON_WRITE_DATABASE_URL='postgresql://USER:PASSWORD@HOST/DB?sslmode=require'

# プロセス束縛（アプリが読むのはこれのみ）。未設定＝ステートレス起動。
# 手元の既定は disposable。Fly 等のデプロイ先ではその環境の接続先を直接入れる。
DATABASE_URL="$BLT_NEON_DISPOSABLE_DATABASE_URL"

# RO を親へ reset（scripts/neon-reset-ro-from-parent.sh）。
# branch id は br-… のみ（接続 URL の ep-… や postgresql:// を流用しない）。
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
NEON_WRITE_BRANCH_ID=br-xxxxxxxx
NEON_RO_BRANCH_ID=br-xxxxxxxx

# =============================================================================
# Linear（任意。本番 ingest 後の件数投稿）
# =============================================================================
# Settings → Account → Security & Access の personal API key。
# 未設定なら scripts/post-ingest-linear.sh は skip。
# 投稿先 Project 名の上書き（既定は JP 機能サイクル。UUID でも可）。
LINEAR_API_KEY=lin_api_your_key_here
# LINEAR_INGEST_PROJECT='JP 機能サイクル'

# =============================================================================
# Status ページ（任意。scripts/generate-status-page.sh）
# =============================================================================
# ingest 事後にマーカー置換する status.html のパス。リポジトリ外可。
# 未設定かつ assets/apex-site/status.html が無ければ skip（git も触らない）。
# リポジトリ内のファイルだけ差分があれば commit・push する。
# BLT_STATUS_HTML='/path/to/status.html'

# =============================================================================
# EDINET
# =============================================================================
# ローカル起動はダミー可（例: BLT_EDINET_API_KEY=dev-local-dummy）。実取得・smoke は実キー。
BLT_EDINET_API_KEY=your_api_key_here

# =============================================================================
# Feed Trend（匿名検索・ツールヒットカウンター）
# =============================================================================
# origin 非依存。未設定なら emit しない（API は落とさない）。GET /v1/feed/trend は 503。
# Worker は api.* / mcp.* の前段に置かない（Tunnel + Access はそのまま）。手順は workers/feed-trend/README.md。
BLT_FEED_TREND_URL='https://blt-feed-trend.example.workers.dev'
BLT_FEED_TREND_TOKEN='your_feed_trend_token_here'

# =============================================================================
# 内訳 LLM（breakdowns business / geography）
# =============================================================================
# openai | xai（未設定は xai）。キーは両方置いたまま LLM_PROVIDER で切替できる。
LLM_PROVIDER=openai
OPENAI_BUSINESS_API_KEY=your_api_key_here
OPENAI_BUSINESS_MODEL=gpt-5.6-luna
OPENAI_GEOGRAPHY_API_KEY=your_api_key_here
OPENAI_GEOGRAPHY_MODEL=gpt-5.6-luna
XAI_BUSINESS_API_KEY=your_api_key_here
XAI_BUSINESS_MODEL=your_xai_model_here
XAI_GEOGRAPHY_API_KEY=your_api_key_here
XAI_GEOGRAPHY_MODEL=your_xai_model_here

# =============================================================================
# R2（会社アイコン公開 URL ＋ 生 XBRL ZIP の私有 L2）
# =============================================================================
# アカウントと鍵は共有。バケットは分ける（アイコンは公開カスタムドメイン、XBRL は私有）。
# アイコン read は BLT_R2_PUBLIC_BASE_URL のみ。アップロードには ACCOUNT_ID / 鍵 / ICONS_BUCKET も必要。
# 生 XBRL の L2（`jp/edinet/xbrl/{docID}.zip`）は ACCOUNT_ID / 鍵 / XBRL_BUCKET が揃えば有効。
# 公開 URL は不要。未設定時はローカル → EDINET の従来経路。
BLT_R2_ACCOUNT_ID=your_account_id_here
BLT_R2_ACCESS_KEY_ID='your_access_key_id_here'
BLT_R2_SECRET_ACCESS_KEY='your_secret_access_key_here'
BLT_R2_ICONS_BUCKET='your_icons_bucket_here'
BLT_R2_PUBLIC_BASE_URL='https://your_r2_public_base_url_here'
BLT_R2_XBRL_BUCKET='your_xbrl_bucket_here'
# 旧名 BLT_R2_BUCKET はアイコン用の互換（ICONS_BUCKET 未設定時のみ）。XBRL には使わない。
