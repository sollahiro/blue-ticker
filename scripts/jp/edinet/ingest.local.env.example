# 手元 ingest チューニング（limit / skip / write 等）。PR 不要。
#
#   cp scripts/jp/edinet/ingest.local.env.example scripts/jp/edinet/ingest.local.env
#
# ingest-common.sh が存在時に自動 load。.env（秘密・接続先）とは分離。

# 本番 write（使い捨てのみなら 0 または未設定）
BLT_INGEST_WRITE=1

# 各 job の --limit（job スクリプト既定を上書き）
BLT_INGEST_FILING_LIMIT=80
BLT_INGEST_STATEMENTS_LIMIT=80
BLT_INGEST_NOTES_LIMIT=80
BLT_INGEST_BREAKDOWN_LIMIT=50
BLT_INGEST_FINANCIALS_LIMIT=80
BLT_INGEST_OVERVIEW_LIMIT=80

# ingest-run-cycle: job 間 sleep 秒
BLT_INGEST_CYCLE_PAUSE_SEC=5

# ingest-run-cycle: 飛ばす job（1 で skip。00–06）
# BLT_INGEST_SKIP_00=1
# BLT_INGEST_SKIP_03=1
# BLT_INGEST_SKIP_06=1

# 事後処理（status ページ / Linear 投稿 / RO reset）を飛ばす
# BLT_INGEST_SKIP_POST=1
