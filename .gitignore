*.log
mebuki_crash.log
mebuki_main.log
mebuki_startup.log

# Environment variables
.env
.env.local
.env.*.local

# Machine-local ingest schedule and wrappers (launchd/cron が呼ぶ実体).
# 正本ジョブは scripts/jp/edinet/ingest-job-*.sh（Git 管理）。雛形は *.local.example.sh。
/scripts/blt-scheduled-sync.sh
/scripts/install-launchd.sh
/scripts/launchd/
/scripts/jp/edinet/*.local.sh
/scripts/jp/edinet/local/
/scripts/jp/edinet/ingest.local.env

# Cloudflare Wrangler (Feed Trend Worker)
workers/**/.wrangler/
workers/**/node_modules/
workers/**/.dev.vars

# Temporary files
*_dump_*.json
*.tmp
*.temp

