# ==========================================
# Application-specific
# ==========================================
# Cache directories
cache/
analysis_cache/
tmp_cache/
# Full EDINET taxonomy zips / extracted trees (~105MB). Japanese _lab.xml
# excerpts for ingest live in assets/taxonomy/labels/ (git-tracked).
/taxonomy/
assets/taxonomy/GAAP/
assets/taxonomy/IFRS/

# Reports and generated data
reports/
reports/*_edinet/
data/

# 日経225構成銘柄リスト（編集著作物のため非公開・ローカル専用。ingest優先ソートの入力）
/assets/nikkei225.csv

# Local app state (when MEBUKI_USER_DATA_PATH points at the repo)
/config.json
/config.json.bak

# Application logs
*.log
mebuki_crash.log
mebuki_main.log
mebuki_startup.log

# Environment variables
.env
.env.local
.env.*.local

# Machine-local ingest leftovers (launchd/cron が呼ぶ実体)。運用正本は
# .agents/skills/production-ingest/SKILL.md。Git 管理の起動スクリプトは置かない。
# 取り込み Mac 上のこれらのファイルは、ラッパー切替後に手元で消す（この ignore だけでは消えない）。
/scripts/blt-scheduled-sync.sh
/scripts/install-launchd.sh
/scripts/launchd/
/scripts/jp/edinet/*.local.sh
/scripts/jp/edinet/local/
/scripts/jp/edinet/ingest.local.env

# Cloudflare Wrangler (Feed Trend Worker)
workers/**/.wrangler/
workers/**/node_modules/
workers/**/.dev.vars

# Temporary files
*_dump_*.json
*.tmp
*.temp

# ==========================================
# IDE / Editors
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/
.gemini/
.agent/

# ==========================================
# OS
# ==========================================
.DS_Store
.DS_Store?
._*

# ==========================================
# Swift / SPM
# ==========================================
.build/
.swiftpm/
**/xcuserdata/
*.o
*.d

# iOS ローカル検証用の派生ビルド出力（Apps/BlueTicker/.derived-debug 等）
.derived-debug/

# ==========================================
# Secrets and credentials
# ==========================================
*.pem
*.key
*.cert
secrets/
credentials/
.build-ingest/
